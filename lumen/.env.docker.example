# Copy to `.env` next to docker-compose.yml (Compose reads it automatically). Never commit it.
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Optional
# APP_PORT=8000
# DB_PORT=5433
# Anthropic Claude for Ask AI: Haiku 5.5 answers everyday questions, Sonnet 5.5 only complex ones.
# Only Claude Haiku / Sonnet model IDs are accepted (Opus and Fable are refused at startup).
ANTHROPIC_API_KEY=
# ANTHROPIC_SIMPLE_MODEL=claude-haiku-5-5
# ANTHROPIC_COMPLEX_MODEL=claude-sonnet-5-5
# Alternative OpenAI-compatible provider (used only when ANTHROPIC_API_KEY is empty):
# LLM_BASE_URL=https://api.openai.com/v1     # or http://host.docker.internal:11434/v1 for Ollama on the host
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
# LUMEN_SECRET_KEY=                          # Fernet key for saved connector passwords
# MAX_UPLOAD_MB=200

# Passwords for external database connectors. In the connector form put only the variable NAME
# (e.g. LUMEN_CONN_ELLEMENTRY_PASSWORD) — the value never leaves this file. Names must start with LUMEN_CONN_.
# Host databases on this PC are reached from Docker as host.docker.internal.
# LUMEN_CONN_ELLEMENTRY_PASSWORD=
