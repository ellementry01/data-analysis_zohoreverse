# Copy to backend/.env and adjust. Never commit real secrets.

# --- PostgreSQL (application metadata + analytical data) -----------------------------------------
# The password can be omitted here when it is stored in pgpass.conf (%APPDATA%\postgresql\pgpass.conf)
# or provided through the PGPASSWORD environment variable.
DATABASE_URL=postgresql+psycopg://postgres@localhost:5432/ellementry_analytics
# Optional: a dedicated read-only login for AI / SQL-console queries (recommended, see README)
# READONLY_DATABASE_URL=postgresql+psycopg://ellementry_reader@localhost:5432/ellementry_analytics

# --- Anthropic Claude (Ask AI) ---------------------------------------------------------------------
# Routing: Claude Haiku 5.5 for everyday questions, Claude Sonnet 5.5 only for complex ones.
# Only Claude Haiku / Sonnet model IDs are accepted; Opus, Fable and Mythos are refused at startup.
ANTHROPIC_API_KEY=
# ANTHROPIC_SIMPLE_MODEL=claude-haiku-5-5
# ANTHROPIC_COMPLEX_MODEL=claude-sonnet-5-5

# --- Optional OpenAI-compatible LLM (used only when ANTHROPIC_API_KEY is empty) --------------------
# OpenAI:        LLM_BASE_URL=https://api.openai.com/v1      LLM_MODEL=gpt-4o-mini
# Ollama local:  LLM_BASE_URL=http://localhost:11434/v1      LLM_MODEL=llama3.1     (no key needed)
# LM Studio:     LLM_BASE_URL=http://localhost:1234/v1
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini

# --- Connector password encryption (Fernet key) -----------------------------------------------------
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ELLEMENTRY_SECRET_KEY=

# --- Guard rails ------------------------------------------------------------------------------------
# QUERY_TIMEOUT_MS=15000
# AI_QUERY_TIMEOUT_MS=10000
# QUERY_ROW_LIMIT=5000
# MAX_UPLOAD_MB=200

# --- Misc ------------------------------------------------------------------------------------------
# UPLOAD_DIR=data/uploads
# DEFAULT_USER=owner@local
# ENABLE_SCHEDULER=true
# TODAY_OVERRIDE=2026-10-17     # pin "today" for reproducible demos/tests
